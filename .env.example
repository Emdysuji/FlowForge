APP_NAME=FlowForge
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql+psycopg2://flowforge:flowforge@db:5432/flowforge
SCHEDULER_TIMEZONE=UTC

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=change_me
SMTP_SENDER=noreply@example.com
SMTP_USE_TLS=true

CSV_OUTPUT_DIR=./data/exports
WORKFLOW_LOG_FILE=./logs/workflow_runs.log
SYSTEM_LOG_FILE=./logs/system.log
REQUESTS_TIMEOUT_SECONDS=20
